{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proxynova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "bfe83e22-0fda-45cc-b178-53b05b72dd85","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "151e2c65776b45808ae10a46fd1b184a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
